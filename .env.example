PORT="3000"

# ------------------------------------------------------------
# Database configuration
# ------------------------------------------------------------
# Local dev (SQLite, no setup required):
DATABASE_NAME="kratosjs.sqlite"

# Production (Render): set DATABASE_URL instead — its presence switches the
# app to Postgres (see src/index.ts). Render injects this automatically when
# you link a managed Postgres database to the web service.
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
# Generate a real value for production, e.g.: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production"
